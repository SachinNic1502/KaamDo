# MongoDB
MONGODB_URI=mongodb://localhost:27017/kaamdo

# JWT
JWT_SECRET=generate-a-strong-random-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate-a-different-secret-for-refresh-tokens
JWT_REFRESH_EXPIRES_IN=30d

# Redis (for OTP storage and caching)
REDIS_URL=redis://localhost:6379

# API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Firebase (for notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Provider (Razorpay/Cashfree)
PAYMENT_PROVIDER_KEY=your-payment-provider-key
PAYMENT_PROVIDER_SECRET=your-payment-provider-secret
# WhatsApp OTP via open-wa Easy API (v4 default; set 5 only for a v5 server)
OPENWA_API_VERSION=4
OPENWA_SEND_TEXT_URL=http://127.0.0.1:8080/sendText
OPENWA_API_KEY=

# Enable only after sandbox tests, Mongo replica-set transactions and indexes pass.
PAYMENTS_ENABLED=false
# Business-approved fee in basis points: 100 basis points = 1 percent. No default.
PLATFORM_FEE_BPS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
